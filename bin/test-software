#!/usr/bin/env python3
"""A small local task manager for the terminal."""

from __future__ import annotations

import argparse
import json
import os
import sys
from pathlib import Path

APP_NAME = "test-software"
DATA_FILE = Path(
    os.environ.get(
        "TEST_SOFTWARE_DATA_FILE",
        Path.home() / "Library" / "Application Support" / APP_NAME / "tasks.json",
    )
)


def load_tasks() -> list[dict[str, object]]:
    try:
        with DATA_FILE.open(encoding="utf-8") as file:
            tasks = json.load(file)
    except FileNotFoundError:
        return []
    except (json.JSONDecodeError, OSError) as error:
        print(f"Unable to read {DATA_FILE}: {error}", file=sys.stderr)
        raise SystemExit(1) from error

    if not isinstance(tasks, list):
        print(f"Invalid task data in {DATA_FILE}", file=sys.stderr)
        raise SystemExit(1)
    return tasks


def save_tasks(tasks: list[dict[str, object]]) -> None:
    try:
        DATA_FILE.parent.mkdir(parents=True, exist_ok=True)
        temporary_file = DATA_FILE.with_suffix(".tmp")
        with temporary_file.open("w", encoding="utf-8") as file:
            json.dump(tasks, file, indent=2)
            file.write("\n")
        temporary_file.replace(DATA_FILE)
    except OSError as error:
        print(f"Unable to save {DATA_FILE}: {error}", file=sys.stderr)
        raise SystemExit(1) from error


def get_task(tasks: list[dict[str, object]], task_id: int) -> dict[str, object]:
    for task in tasks:
        if task["id"] == task_id:
            return task
    print(f"No task with ID {task_id}.", file=sys.stderr)
    raise SystemExit(1)


def add_task(args: argparse.Namespace) -> None:
    tasks = load_tasks()
    next_id = max((int(task["id"]) for task in tasks), default=0) + 1
    tasks.append({"id": next_id, "title": " ".join(args.title), "done": False})
    save_tasks(tasks)
    print(f"Added task {next_id}: {' '.join(args.title)}")


def list_tasks(args: argparse.Namespace) -> None:
    tasks = load_tasks()
    if not args.all:
        tasks = [task for task in tasks if not task["done"]]

    if not tasks:
        print("No tasks found.")
        return

    for task in tasks:
        marker = "x" if task["done"] else " "
        print(f"{task['id']:>3}  [{marker}]  {task['title']}")


def complete_task(args: argparse.Namespace) -> None:
    tasks = load_tasks()
    task = get_task(tasks, args.task_id)
    task["done"] = True
    save_tasks(tasks)
    print(f"Completed task {args.task_id}: {task['title']}")


def remove_task(args: argparse.Namespace) -> None:
    tasks = load_tasks()
    task = get_task(tasks, args.task_id)
    tasks.remove(task)
    save_tasks(tasks)
    print(f"Removed task {args.task_id}: {task['title']}")


def build_parser() -> argparse.ArgumentParser:
    parser = argparse.ArgumentParser(description="Manage a small local task list.")
    subcommands = parser.add_subparsers(dest="command", required=True)

    add_parser = subcommands.add_parser("add", help="Add a task")
    add_parser.add_argument("title", nargs="+", help="Task description")
    add_parser.set_defaults(handler=add_task)

    list_parser = subcommands.add_parser("list", help="List tasks")
    list_parser.add_argument("--all", action="store_true", help="Include completed tasks")
    list_parser.set_defaults(handler=list_tasks)

    done_parser = subcommands.add_parser("done", help="Mark a task complete")
    done_parser.add_argument("task_id", type=int, help="Task ID")
    done_parser.set_defaults(handler=complete_task)

    remove_parser = subcommands.add_parser("remove", help="Remove a task")
    remove_parser.add_argument("task_id", type=int, help="Task ID")
    remove_parser.set_defaults(handler=remove_task)

    return parser


def main() -> None:
    args = build_parser().parse_args()
    args.handler(args)


if __name__ == "__main__":
    main()